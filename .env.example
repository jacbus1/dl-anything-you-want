HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Media downloader
COBALT_URL=
COBALT_API_KEY=
MAX_FILE_MB=100

# Profile Research Mode
# Instagram: optional operator-owned Instaloader session for login-gated public profiles.
INSTAGRAM_SESSIONFILE=
INSTAGRAM_SESSION_USERNAME=

# TikTok: optional operator-owned Netscape-format cookies file for yt-dlp.
TIKTOK_COOKIES_FILE=

# Threads profile enumeration uses a provider adapter in v0.5.0.
APIFY_TOKEN=
THREADS_APIFY_ACTOR=logiover~threads-scraper

# GitHub enrichment. Strongly recommended for large profiles to avoid anonymous rate limits.
GITHUB_TOKEN=

# Optional OpenAI-compatible summarization endpoint. Without this, local extractive summaries are used.
SUMMARY_API_URL=
SUMMARY_API_KEY=
SUMMARY_MODEL=
