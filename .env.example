HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# Set only to your own Cobalt API. Never use somebody else's public instance without permission.
COBALT_URL=
COBALT_API_KEY=
MAX_FILE_MB=100
# Required only for TEXT output when running without Docker.
WHISPER_BIN=whisper-cli
WHISPER_MODEL=
